{
  "name": "@nixcord/cli",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:bundle && bun --bun tsc --build --emitDeclarationOnly --force",
    "build:bundle": "bun --bun vite build"
  },
  "bin": {
    "generate-plugin-options": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "dependencies": {
    "@nixcord/domain": "workspace:*",
    "@nixcord/git-analyzer": "workspace:*",
    "@nixcord/nix-generator": "workspace:*",
    "@nixcord/parser": "workspace:*",
    "@nixcord/shared": "workspace:*",
    "@optique/core": "^1.3.6",
    "@optique/run": "^1.3.6",
    "deepmerge-ts": "^8.0.2",
    "effect": "4.0.6",
    "fs-extra": "^11.4.1",
    "ora": "^9.4.1",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "fs-fixture": "2.16.0"
  },
  "files": [
    "dist"
  ]
}
