{
  "name": "@nixcord/parser",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:bundle && bun --bun tsc --build --emitDeclarationOnly --force",
    "build:bundle": "bun --bun vite build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "pathe": "^2.0.3",
    "@nixcord/domain": "workspace:*",
    "@nixcord/setting-analysis": "workspace:*",
    "@nixcord/slice-executor": "workspace:*",
    "effect": "4.0.6",
    "@nixcord/typescript-analysis": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "fs-fixture": "2.16.0"
  },
  "files": [
    "dist"
  ]
}
