{
  "name": "@nixcord/nix-generator",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:bundle && bun --bun tsc --build --emitDeclarationOnly --force",
    "build:bundle": "bun --bun vite build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./identifier": {
      "types": "./src/identifier.ts",
      "import": "./dist/identifier.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "dependencies": {
    "change-case": "^5.4.4",
    "fs-extra": "^11.4.1",
    "pathe": "^2.0.3",
    "@nixcord/domain": "workspace:*",
    "valibot": "^1.5.0",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "fs-fixture": "2.16.0",
    "@nixcord/shared": "1.0.0"
  },
  "files": [
    "dist"
  ]
}
