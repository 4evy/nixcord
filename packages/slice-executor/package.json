{
  "name": "@nixcord/slice-executor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:bundle && bun --bun tsc --build --emitDeclarationOnly --force",
    "build:bundle": "bun --bun vite build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./execution-runner": {
      "types": "./src/runner.ts",
      "import": "./dist/runner.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "dependencies": {
    "@nixcord/typescript-analysis": "workspace:*",
    "effect": "4.0.5",
    "quickjs-emscripten": "0.32.0"
  },
  "files": [
    "dist"
  ]
}
