{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/domain",
    "packages/typescript-analysis",
    "packages/setting-analysis",
    "packages/slice-executor",
    "packages/git-analyzer",
    "packages/nix-generator",
    "packages/parser",
    "packages/cli",
    "docs/site"
  ],
  "scripts": {
    "build": "bun run build:packages && bun run docs:build",
    "pretest": "bun run build:packages",
    "test": "bun node_modules/vitest/vitest.mjs run --exclude 'packages/parser/tests/validation/**' --no-isolate --fsModuleCache --maxWorkers=4",
    "test:all": "bun run test && bun run test:upstream",
    "pretest:upstream": "bun run build:packages",
    "test:upstream": "bun node_modules/vitest/vitest.mjs run packages/parser/tests/validation/real-world.test.ts --no-isolate --fsModuleCache --maxWorkers=4",
    "pretest:watch": "bun run build:packages",
    "test:watch": "bun node_modules/vitest/vitest.mjs --exclude 'packages/parser/tests/validation/**' --no-isolate --maxWorkers=4",
    "typecheck": "bun --bun tsc --build",
    "clean": "bun scripts/clean/clean.ts",
    "format": "bun --bun biome check --write .",
    "format:check": "bun --bun biome check .",
    "lint": "bun --bun fallow dead-code && bun --bun fallow dupes",
    "lint:health": "bun --bun fallow health",
    "docs:dev": "bun run --cwd docs/site dev",
    "docs:dev:options": "bun run --cwd docs/site dev:options",
    "docs:prepare-options": "bun run --cwd docs/site prepare-options",
    "docs:build": "bun run --cwd docs/site build",
    "docs:check": "bun run --cwd docs/site check",
    "docs:preview": "bun run --cwd docs/site preview",
    "check": "bun run typecheck && bun run docs:check && bun run lint && bun run format:check",
    "build:packages": "bun run --bun --filter './packages/*' build:bundle && bun --bun tsc --build packages/* modules/lib --emitDeclarationOnly --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.5",
    "equicord": "https://github.com/Equicord/Equicord/archive/8d0ebf3549890be2ecb1e1d602b1695f584c71cc.tar.gz",
    "fallow": "3.36.0",
    "svelte": "^5.57.2",
    "typescript": "7.1.0-beta",
    "vencord": "https://github.com/Vendicated/Vencord/archive/8d64c8be7e68616f8f116a6fff9480051aa2a0c5.tar.gz",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "equicord": {
      "@ffmpeg/ffmpeg": "^0.12.10",
      "@ffmpeg/util": "^0.12.1",
      "@intrnl/xxhash64": "^0.1.2",
      "@song-spotlight/api": "^2.2.0",
      "@streamparser/json": "^0.0.22",
      "@vap/core": "0.0.12",
      "@vap/shiki": "0.10.5",
      "fflate": "^0.8.3",
      "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3",
      "gifuct-js": "^2.1.2",
      "idb": "8.0.3",
      "jsqr": "1.4.0",
      "monaco-editor": "^0.57.0",
      "nanoid": "^5.1.16",
      "native-file-system-adapter": "^3.0.1",
      "yaml-js": "^0.3.1"
    },
    "vencord": {
      "@intrnl/xxhash64": "^0.1.2",
      "@vap/core": "0.0.12",
      "@vap/shiki": "0.10.5",
      "@vencord/monaco-editor": "0.57.0-beta.4",
      "fflate": "^0.8.3",
      "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3"
    }
  }
}
