{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "vite.config.shared.ts",
    "pkgs/discord/patching/updater/main.ts",
    "pkgs/discord/patching/launcher/main.ts",
    "pkgs/discord/platforms/darwin/modules/redirect.cjs",
    "modules/lib/legcord-build.ts",
    "packages/slice-executor/src/runner.ts",
    "pkgs/discord/patching/krisp/main.ts"
  ],
  "ignoreDependencies": [
    "@typescript/native",
    "electron",
    "equicord",
    "renovate",
    "vencord"
  ],
  "audit": {
    "gate": "all"
  },
  "health": {
    "maxCyclomatic": 50,
    "maxCognitive": 60,
    "maxCrap": 300
  },
  "duplicates": {
    "ignore": [
      "**/tests/**",
      "**/*.test.ts"
    ]
  },
  "framework": [
    {
      "name": "nixcord-tooling",
      "entryPoints": [
        "scripts/**/*.ts"
      ],
      "entryPointRole": "support"
    }
  ]
}
